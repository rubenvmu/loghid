@page
@model loghid.Pages.NewClientMeasurement.IndexModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ClientMeasurement[0].Date_Measurement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientMeasurement[0].Location_Measurement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientMeasurement[0].IsoThreshold_Measurement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientMeasurement[0].MeasurementMethod_Measurement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientMeasurement[0].MeasuredRange_Measurement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientMeasurement[0].Probability_Measurement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientMeasurement[0].Value_Measurement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClientMeasurement[0].Notes_Measurement)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ClientMeasurement) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Date_Measurement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location_Measurement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsoThreshold_Measurement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MeasurementMethod_Measurement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MeasuredRange_Measurement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Probability_Measurement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Value_Measurement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes_Measurement)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id_Measurement">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id_Measurement">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id_Measurement">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</body>
</html>
