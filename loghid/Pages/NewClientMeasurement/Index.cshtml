@page
@model loghid.Pages.NewClientMeasurement.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Substance[0].SubstanceName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Substance[0].IsoThreshold)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Substance[0].MeasurementMethod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Substance[0].MeasuredRange)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Substance[0].Probability)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Substance) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SubstanceName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsoThreshold)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MeasurementMethod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MeasuredRange)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Probability)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
