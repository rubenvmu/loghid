                <input asp-for="ClientMeasurement.Notes_Measurement" class="form-control" />
                <span asp-validation-for="ClientMeasurement.Notes_Measurement" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

</body>
</html>
