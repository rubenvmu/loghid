            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="ClientMeasurement.Probability_Measurement" class="control-label"></label>
                <input asp-for="ClientMeasurement.Probability_Measurement" class="form-control" />
