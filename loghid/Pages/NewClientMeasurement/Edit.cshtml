    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit</title>
</head>
<body>

<h4>ClientMeasurement</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ClientMeasurement.Id_Measurement" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="ClientMeasurement.Date_Measurement" class="control-label"></label>
