@page
@model loghid.Pages.NewClientMeasurement.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1>Create</h1>
        
    <h4>Substance</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
