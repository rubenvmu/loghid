@page
@model loghid.Pages.Movilabs.IndexModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].Vehicle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].VehiclePrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].CargoCapacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].InteriorSpace)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].AutonomyCapacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].PricePer100km)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].Chromatograph)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].TCD)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].FID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].Hygrometer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].FPD)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].PressureRegulators)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].StandardGasBottles)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].GasColumns)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].HeliumCarrierGas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].AirFuelGas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].ChromatographCertification)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].RegulatoryConsultations)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].AnalysisService)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].Calibration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.eSprinterLab[0].VehicleMaintenance)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.eSprinterLab) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Vehicle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehiclePrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CargoCapacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InteriorSpace)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AutonomyCapacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PricePer100km)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Chromatograph) 15 years
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TCD) 10 years
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FID) 10 years
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Hygrometer) 10 years
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FPD) 10 years
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PressureRegulators) 10 years
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StandardGasBottles) anual
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GasColumns) for 1.5 years
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HeliumCarrierGas) anual
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AirFuelGas) anual
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ChromatographCertification) anual
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegulatoryConsultations) anual
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AnalysisService) for day.
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Calibration) for station.
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehicleMaintenance) for day.
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</body>
</html>
