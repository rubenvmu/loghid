@page
@model loghid.Pages.Movilabs.IndexModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Lastest Certificates"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: #f1f1f1;
    font-family: Arial, sans-serif;
}

.drag-drop-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.card-container {
    background: white;
    padding: 2rem;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    border-radius: 0;
    width: 80%;
    max-width: 500px;
    text-align: center;
}

.create-header {
    font-size: 1.5rem;
    font-weight: bold;
    color: #2c3e50;
    margin-bottom: 2rem;
    padding: 1rem 0;
    border-bottom: 2px solid #f1f1f1;
}

.create-circle {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 2rem auto;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none; /* Evita la línea azul */
}

.create-circle i {
    font-size: 3rem;
    color: #ffffff; /* Ícono blanco */
    transition: all 0.3s ease;
}

.create-circle:hover {
    transform: scale(1.05);
}

.navbar-horizontal {
    width: 100%;
    height: 90px;
    position: fixed;
    bottom: 0;
    left: 0;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 25px;
    padding: 0 20px;
    z-index: 1030;
}

.nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px;
    border-radius: 16px;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 1.95);
    text-decoration: none !important;
    position: relative;
}

.nav-link i {
    font-size: 1.8rem;
    color: #2c3e50 !important; /* Íconos en azul */
    transition: all 0.3s ease;
}

.nav-link span {
    font-size: 0.75rem;
    color: #2c3e50;
    position: absolute;
    bottom: -25px;
    opacity: 0;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.nav-link:hover {
    transform: translateY(-15px) scale(1.05);
    background: rgba(244, 244, 244, 0.7);
}

.nav-link:hover i {
    transform: scale(1.05);
}

.nav-link:hover span {
    opacity: 1;
    bottom: -20px;
}

.nav-link:hover {
    background-color: #ffffff; /* Fondo blanco en hover */
}

.nav-link:hover i {
    color: #2c3e50; /* Los íconos siguen siendo azules cuando se pasa el cursor */
}

#sprinterLabTable {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        font-family: 'Inter', system-ui, sans-serif;
        background-color: #0f1a24;
    }
    
    #sprinterLabTable tr:hover {
        background-color: rgba(26, 43, 60, 0.1);
    }
    
    #sprinterLabTable tbody tr:nth-child(even) {
        background-color: rgba(26, 43, 60, 0.05);
    }
    
    #sprinterLabTable th {
        font-size: 0.92rem;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        padding: 16px 15px;
    }
    
    #sprinterLabTable td {
        font-size: 0.95rem;
        vertical-align: middle;
        padding: 14px 12px;
    }
    
    #sprinterLabTable a:hover {
        text-decoration: underline;
        opacity: 0.9;
    }
</style>

    <nav class="navbar-horizontal">
    <!-- Barra de navegación con íconos azul sobre blanco -->
    <a class="nav-link" asp-page="/Index">
        <i class="fas fa-home"></i>
        <span>Index</span>
    </a>
    <a class="nav-link" asp-page="/Dashboard">
        <i class="fas fa-chart-line"></i>
