@page
@model loghid.Pages.Movilabs.IndexModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Lastest Certificates"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<style>
        
        /* Estilos anteriores se mantienen igual */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 2rem;
            background-color: #f5f7fa;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .create-btn {
            background-color: #2a5f8a;
            color: white;
            padding: 0.8rem 1.5rem;
            border-radius: 5px;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 2rem;
            transition: background-color 0.3s;
        }

        .create-btn:hover {
            background-color: #1d4565;
        }

        .item-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
            padding: 1.5rem;
        }

        .property-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            padding: 1rem 0;
            border-bottom: 1px solid #eee;
        }

        .property-row:last-child {
            border-bottom: none;
        }

        .property-label {
            color: #2a5f8a;
            font-weight: 600;
        }

        .property-value {
            color: #333;
            font-weight: 400;
        }

        .actions {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid #eee;
        }

        .action-link {
            color: #2a5f8a;
            text-decoration: none;
            margin-right: 1rem;
            transition: color 0.3s;
        }

        .action-link:hover {
            color: #1d4565;
        }

        .total-price {
            font-size: 1.2rem;
            font-weight: bold;
            color: #2a5f8a;
            margin-top: 1rem;
        }
        .container {
            margin-top: 20px; /* Aumentar margen superior */
        }

        /* Estilo para las cards */
        .card {
            margin-bottom: 2rem;
            border: 0;
            border-radius: 0;
            background: #f8f9fa;
            transition: transform 0.3s;
            position: relative;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card-header {
            background: #2c3e50;
            color: white;
            border-radius: 0 !important;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-title {
            margin: 0;
            font-size: 1.25rem;
        }

        .edit {
            background: #2c3e50;
            color: #ffffff;
        }

        .data-label {
            font-weight: 600;
            color: #455a64;
            font-size: 0.9rem;
        }

        .card-text {
            color: #37474f;
            font-size: 0.95rem;
        }

.navbar-horizontal {
  width: 100%;
  height: 90px;
  position: fixed;
  bottom: 0;
  left: 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 25px;
  padding: 0 20px;
  z-index: 1030;
}

.nav-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px;
  border-radius: 16px;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 1.95);
  text-decoration: none !important;
  position: relative;
}

.nav-link i {
  font-size: 1.8rem;
  color: #2c3e50 !important;
  transition: all 0.3s ease;
}

.nav-link span {
  font-size: 0.75rem;
  color: #2c3e50;
  position: absolute;
  bottom: -25px;
  opacity: 0;
  transition: all 0.3s ease;
  white-space: nowrap;
}
.nav-link:hover {
  transform: translateY(-15px) scale(1.05);
  background: rgba(244, 244, 244, 0.7);
}

.nav-link:hover i {
  transform: scale(1.05);
}

.nav-link:hover span {
  opacity: 1;
  bottom: -20px;
}

.nav-link:hover + .nav-link,
.nav-link:hover ~ .nav-link {
  transform: translateY(-5px) scale(1.05);
}

.edit-link {
    color: #2c3e50; /* Texto e icono en blanco */
    padding: 0.5rem 1rem; /* Espaciado interno */
    display: flex;
    gap: 0.5rem; /* Espacio entre icono y texto */
    font-size: 1.2rem; /* Tamaño del texto */
    font-weight: bold;
    transition: all 0.3s ease;
    text-decoration: none;
    width: fit-content;
}

.edit-link i {
    font-size: 1.5rem; /* Tamaño del icono */
    color: #2c3e50;
}


.download-link {
    background: #2c3e50; /* Azul oscuro */
    color: white; /* Texto e icono en blanco */
    padding: 0.5rem 1rem; /* Espaciado interno */
    display: flex;
    gap: 0.5rem; /* Espacio entre icono y texto */
    font-size: 1rem; /* Tamaño del texto */
    font-weight: bold;
    transition: all 0.3s ease;
    text-decoration: none;
    width: fit-content;
}

.download-link i {
    font-size: 1.2rem; /* Tamaño del icono */
    color: white;
}


/* Eliminar el estilo de enlace (color azul) */
.download-link:focus, .download-link:active, .download-link:link, .download-link:visited {
    color: white;
    text-decoration: none

.edit-link:focus, .edit-link:active, .edit-link:link, .edit-link:visited {
    color: white;
    text-decoration: none

    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
    }

    #mapContainer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: calc(100vh - 80px);
    }

    #mapWrapper {
        width: 100%;
        height: 100%;
    }

    #mapWrapper iframe {
        width: 100%;
        height: 100%;
        border: none;
        background: #f8f9fa;
    }

    #navbarHorizontal {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 80px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 25px;
        padding: 0 20px;
        z-index: 1000;
    }
</style>
<body>
    <nav class="navbar-horizontal">
    <a class="nav-link" asp-page="/Index">
        <i class="fas fa-home"></i>
        <span>Home</span>
    </a>

    <a class="nav-link" asp-page="/Dashboard">
        <i class="fas fa-chart-line"></i>
        <span>ISO Parameters</span>
    </a>

    <a class="nav-link" asp-page="/Trazability">
        <i class="fas fa-gas-pump"></i>
        <span>Trazability</span>
    </a>

    <a class="nav-link" asp-page="/New-Measurement/Index">
        <i class="fas fa-circle-plus"></i>
        <span>New Measurement</span>
    </a>

    <a class="nav-link" asp-page="Certificates/CertificatesIndex">
        <i class="fas fa-certificate"></i>
        <span>Certificates</span>
    </a>

    <a class="nav-link" asp-page="/Movilabs/Index">
        <i class="fas fa-truck"></i>
        <span>Movilabs</span>
    </a>

    <a class="nav-link" asp-page="/Incidents">
        <i class="fas fa-exclamation-circle"></i>
        <span>Incidents</span>
    </a>

    <a class="nav-link" asp-page="/Support">
        <i class="fas fa-info-circle"></i>
        <span>Support</span>
    </a>

    <a class="nav-link" asp-page="/Privacy">
        <i class="fas fa-shield-alt"></i>
        <span>Privacy</span>
    </a>

</nav>
    <div class="container">
        <a asp-page="Create" class="create-btn">Create New Lab</a>

        @foreach (var item in Model.eSprinterLab)
        {
            <div class="item-card">
                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].Vehicle)</div>
                    <div class="property-value">@item.Vehicle</div>
                </div>
                
                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].VehiclePrice)</div>
                    <div class="property-value">@item.VehiclePrice.ToString("N0") €</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].CargoCapacity)</div>
                    <div class="property-value">@item.CargoCapacity.ToString("N0") kg</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].InteriorSpace)</div>
                    <div class="property-value">@item.InteriorSpace.ToString("N2") m³</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].AutonomyCapacity)</div>
                    <div class="property-value">@item.AutonomyCapacity.ToString("N0") km</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].PricePer100km)</div>
                    <div class="property-value">@item.PricePer100km.ToString("N2") €</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].Chromatograph)</div>
                    <div class="property-value">@item.Chromatograph.ToString("N0") € (15 Years)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].TCD)</div>
                    <div class="property-value">@item.TCD.ToString("N0") € (10 Years)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].FID)</div>
                    <div class="property-value">@item.FID.ToString("N0") € (10 Years)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].Hygrometer)</div>
                    <div class="property-value">@item.Hygrometer.ToString("N0") € (10 Years)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].FPD)</div>
                    <div class="property-value">@item.FPD.ToString("N0") € (10 Years)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].PressureRegulators)</div>
                    <div class="property-value">@item.PressureRegulators.ToString("N0") € (10 Years)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].StandardGasBottles)</div>
                    <div class="property-value">@item.StandardGasBottles.ToString("N0") € (Anual)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].GasColumns)</div>
                    <div class="property-value">x3 @item.GasColumns.ToString("N0") € (1.5 Years)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].HeliumCarrierGas)</div>
                    <div class="property-value">@item.HeliumCarrierGas.ToString("N0") € (Anual)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].AirFuelGas)</div>
                    <div class="property-value">@item.AirFuelGas.ToString("N0") € (Anual)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].ChromatographCertification)</div>
                    <div class="property-value">@item.ChromatographCertification.ToString("N0") € (Anual)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].RegulatoryConsultations)</div>
                    <div class="property-value">@item.RegulatoryConsultations</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].AnalysisService)</div>
                    <div class="property-value">@item.AnalysisService.ToString("N0") € (Per Day)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].Calibration)</div>
                    <div class="property-value">@item.Calibration.ToString("N0") € (Per Station)</div>
                </div>

                <div class="property-row">
                    <div class="property-label">@Html.DisplayNameFor(model => model.eSprinterLab[0].VehicleMaintenance)</div>
                    <div class="property-value">@item.VehicleMaintenance.ToString("N0") € (Per Day)</div>
                </div>

                <div class="total-price">
                    Total Price: @item.TotalPrice.ToString("N0") €
                </div>

                

                <div class="actions">
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="action-link">Edit</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="action-link">Details</a>
                    <a asp-page-handler="Download" asp-route-id="@item.Id" class="action-link">Download PDF</a>
                </div>
            </div>
                <div class="container-fluid">
    <p class="mb-0">.</p>
</div>
<div class="container-fluid">
    <p class="mb-0">.</p>
</div>
        }
    </div>
</body>
</html>