@page
@model loghid.Pages.ISO26142Pages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ISO26142[0].SensorType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISO26142[0].DetectionRange)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISO26142[0].ResponseTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISO26142[0].DisplayName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISO26142[0].StandardCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISO26142[0].Year)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISO26142[0].Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ISO26142) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SensorType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DetectionRange)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ResponseTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DisplayName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StandardCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Year)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
