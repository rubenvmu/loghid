@page
@model Loghid.Pages.DashboardModel
@{
    ViewData["Title"] = "ISO 14687-2 Measurement Dashboard";
}

<style>
    body {
        background: linear-gradient(135deg, #0a192f 0%, #0d2342 100%);
        color: #ccd6f6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
        padding: 2rem 1rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        backdrop-filter: blur(10px);
    }

    h2 {
        color: #64ffda;
        font-weight: 600;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #2f4368;
    }

    .dashboard-card {
        background: rgba(23, 42, 69, 0.95);
        border: 1px solid #2f4368;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .dashboard-card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent 20%, #64ffda33 50%, transparent 80%);
        animation: gradientShift 20s infinite linear;
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.4);
    }

    .card-header {
        background: rgba(31, 48, 79, 0.4);
        border-bottom: 1px solid #2f4368;
        padding: 1.5rem;
        position: relative;
        z-index: 1;
    }

    .card-title {
        color: #64ffda;
        margin: 0;
        font-size: 1.2rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .atom-icon {
        color: #64ffda;
        font-size: 1.2rem;
    }

    .card-body {
        position: relative;
        z-index: 1;
        padding: 1.5rem;
    }

    .data-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        margin: 0.5rem 0;
        background: rgba(47, 67, 104, 0.3);
        border-radius: 8px;
        border: 1px solid #2f4368;
        transition: all 0.3s ease;
    }

    .data-row:hover {
        background: rgba(47, 67, 104, 0.5);
        transform: translateX(5px);
    }

    .data-content {
        flex: 1;
        padding-right: 1rem;
    }

    .spec-label {
        color: #88a9d6;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .spec-value {
        color: #ccd6f6;
        font-size: 1rem;
        font-weight: 600;
        margin-top: 0.3rem;
    }

    .data-icon {
        color: #64ffda;
        font-size: 1.2rem;
        min-width: 30px;
        text-align: center;
    }

    form {
        background: rgba(23, 42, 69, 0.8);
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid #2f4368;
        margin-bottom: 2rem;
    }

    .form-control {
        background: rgba(47, 67, 104, 0.3);
        border: 1px solid #2f4368;
        color: #ccd6f6;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        background: rgba(47, 67, 104, 0.5);
        border-color: #64ffda;
        box-shadow: 0 0 0 3px rgba(100, 255, 218, 0.2);
        color: #ccd6f6;
    }

    .btn-primary {
        background: #64ffda;
        color: #0a192f;
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: #88ffe5;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(100, 255, 218, 0.3);
    }

    .alert-info {
        background: rgba(31, 48, 79, 0.6);
        border-color: #2f4368;
        color: #ccd6f6;
    }

    @@keyframes gradientShift {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .dashboard-card {
            margin-bottom: 1rem;
        }
        
        .card-header {
            padding: 1rem;
        }
    }

    .table {
    color: #ccd6f6;
    border-collapse: separate;
    border-spacing: 0 0.5rem;
}

.table-hover tbody tr:hover {
    background: rgba(47, 67, 104, 0.5) !important;
    transform: translateX(5px);
    transition: all 0.3s ease;
}

.table-borderless th,
.table-borderless td {
    border: none;
}

th.spec-label {
    font-weight: 500;
    font-size: 0.9rem;
    color: #64ffda !important;
    background: rgba(31, 48, 79, 0.4);
    padding: 1rem 1.5rem;
}

td.spec-value {
    padding: 1.2rem 1.5rem;
    vertical-align: middle;
    background: rgba(47, 67, 104, 0.3);
}

tr.data-row {
    border: 1px solid #2f4368;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
}

.table-responsive {
    border-radius: 12px;
    overflow: hidden;
}
#iso14067-dashboard {
        color: #64ffda;
        font-weight: 600;
        margin: 2rem 0;
        padding-bottom: 1rem;
        border-bottom: 2px solid #2f4368;
    }

    .iso14067-container {
        background: rgba(23, 42, 69, 0.95);
        border: 1px solid #2f4368;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        position: relative;
        overflow: hidden;
    }

    .iso14067-container::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent 20%, #64ffda33 50%, transparent 80%);
        animation: iso14067-gradientShift 20s infinite linear;
    }

    .iso14067-table-wrapper {
        position: relative;
        z-index: 1;
        padding: 1.5rem;
    }

    .iso14067-table {
        width: 100%;
        border-collapse: collapse;
        color: #ccd6f6;
    }

    .iso14067-table th {
        background: rgba(31, 48, 79, 0.4);
        padding: 1.5rem;
        font-weight: 500;
        color: #64ffda;
        border-bottom: 2px solid #2f4368;
    }

    .iso14067-table td {
        padding: 1.2rem 1.5rem;
        background: rgba(47, 67, 104, 0.3);
        border-bottom: 1px solid #2f4368;
        transition: all 0.3s ease;
    }

    .iso14067-table tr:hover td {
        background: rgba(47, 67, 104, 0.5);
        transform: translateX(10px);
    }

    .iso14067-table th i {
        margin-right: 0.8rem;
        font-size: 1.1em;
    }

    .iso14067-alert {
        background: rgba(31, 48, 79, 0.6);
        border: 1px solid #2f4368;
        color: #ccd6f6;
        padding: 1rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    @@keyframes iso14067-gradientShift {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .iso14067-container {
            margin: 0 -1rem;
            border-radius: 0;
        }
        
        .iso14067-table th,
        .iso14067-table td {
            padding: 1rem;
            font-size: 0.9em;
        }
    }
</style>

<div class="container">
    <h2>ISO Parameters Dashboard</h2>
    
    <div class="cotainer-fluid">
        <p style="color: #88a9d6;">Search specific parameter:</p>
        <form method="get" asp-page="/DashboardSearch">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="..." name="SearchTerm" value="@Model.SearchTerm" />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
    </div>

    <br>

    <h2>ISO 14687 Dashboard</h2>

    @if (Model?.CombinedSubstances == null || !Model.CombinedSubstances.Any())
    {
        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            No substances available
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.CombinedSubstances)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="dashboard-card">
                        <div class="card-header">
                            <h5 class="card-title">
                                <i class="fas fa-atom atom-icon"></i>
                                @Html.DisplayFor(modelItem => item.SubstanceName)
                            </h5>
                        </div>
                        
                        <div class="card-body">
                            <div class="data-row">
                                <div class="data-content">
                                    <div class="spec-label">ISO Threshold</div>
                                    <div class="spec-value">@Html.DisplayFor(modelItem => item.IsoThreshold)</div>
                                </div>
                                <div class="data-icon">
                                    <i class="fas fa-balance-scale-right"></i>
                                </div>
                            </div>

                            <div class="data-row">
                                <div class="data-content">
                                    <div class="spec-label">Measured Range</div>
                                    <div class="spec-value">@Html.DisplayFor(modelItem => item.MeasuredRange)</div>
                                </div>
                                <div class="data-icon">
                                    <i class="fas fa-wave-square"></i>
                                </div>
                            </div>

                            <div class="data-row">
                                <div class="data-content">
                                    <div class="spec-label">Probability</div>
                                    <div class="spec-value">@Html.DisplayFor(modelItem => item.Probability)%</div>
                                </div>
                                <div class="data-icon">
                                    <i class="fas fa-percentage"></i>
                                </div>
                            </div>

                            <div class="data-row">
                                <div class="data-content">
                                    <div class="spec-label">Measurement Method</div>
                                    <div class="spec-value">@Html.DisplayFor(modelItem => item.MeasurementMethod)</div>
                                </div>
                                <div class="data-icon">
                                    <i class="fas fa-microscope"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h2 id="iso14067-dashboard">ISO 14067 Dashboard</h2>

@if (Model?.ISO14067 == null || !Model.ISO14067.Any())
{
    <div class="iso14067-alert">
        <i class="fas fa-info-circle"></i>
        No ISO 14067 data available
    </div>
}
else
{
    <div class="iso14067-container">
        <div class="iso14067-table-wrapper">
            <table class="iso14067-table">
                <thead>
                    <tr>
                        <th><i class="fas fa-recycle"></i>Assessment Method</th>
                        <th><i class="fas fa-shoe-prints"></i>Carbon Footprint</th>
                        <th><i class="fas fa-file-alt"></i>Standard Code</th>
                        <th><i class="fas fa-sync-alt"></i>Renewal Frequency</th>
                        <th><i class="fas fa-calendar"></i>Year</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ISO14067)
                    {
                        <tr class="iso14067-data-row">
                            <td>@item.LifeCycleAssessmentMethod</td>
                            <td>@item.CarbonFootprint CO₂e</td>
                            <td>@item.StandardCode</td>
                            <td>@item.RenewalFrequency</td>
                            <td>@item.Year</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

    <div class="container-fluid" style="color: #88a9d6; margin-top: 2rem; text-align: center;">
        <p class="mb-0"></p>
    </div>
</div>
