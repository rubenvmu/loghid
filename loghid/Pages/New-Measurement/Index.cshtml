@page
@model loghid.Pages.New_Measurement.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Lastest Certificates"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #0a192f 0%, #0d2342 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow: hidden;
    }

    .drag-drop-container {
        width: 100%;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }

    .card-container {
        background: rgba(23, 42, 69, 0.95);
        padding: 3rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        border-radius: 15px;
        width: 80%;
        max-width: 500px;
        text-align: center;
        border: 1px solid #2f4368;
        backdrop-filter: blur(10px);
        position: relative;
        overflow: hidden;
    }

    .card-container::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent 20%, #64ffda33 50%, transparent 80%);
        animation: gradientShift 20s infinite linear;
    }

    .create-header {
        font-size: 1.8rem;
        font-weight: 600;
        color: #64ffda;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #2f4368;
        position: relative;
        z-index: 1;
    }

    .create-circle {
        width: 140px;
        height: 140px;
        background: rgba(100, 255, 218, 0.1);
        border-radius: 50%;
        margin: 2rem auto;
        display: flex;
        justify-content: center;
        text-decoration: none;
        align-items: center;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid #64ffda;
        position: relative;
        z-index: 1;
    }

    .create-circle i {
        font-size: 3.5rem;
        color: #64ffda;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .create-circle:hover {
        transform: scale(1.05);
        background: rgba(100, 255, 218, 0.2);
        text-decoration: none;
        box-shadow: 0 0 25px rgba(100, 255, 218, 0.3);
    }

    @@keyframes gradientShift {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .navbar-horizontal {
  width: 100%;
  height: 90px;
  position: fixed;
  bottom: 0;
  left: 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 25px;
  padding: 0 20px;
  z-index: 1030;
}

.nav-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px;
  border-radius: 16px;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 1.95);
  text-decoration: none !important;
  position: relative;
}

.nav-link i {
  font-size: 1.8rem;
  color: #2c3e50 !important;
  transition: all 0.3s ease;
}

.nav-link span {
  font-size: 0.75rem;
  color: #2c3e50;
  position: absolute;
  bottom: -25px;
  opacity: 0;
  transition: all 0.3s ease;
  white-space: nowrap;
}
.nav-link:hover {
  transform: translateY(-15px) scale(1.05);
  background: rgba(244, 244, 244, 0.7);
}

.nav-link:hover i {
  transform: scale(1.05);
}

.nav-link:hover span {
  opacity: 1;
  bottom: -20px;
}

.nav-link:hover + .nav-link,
.nav-link:hover ~ .nav-link {
  transform: translateY(-5px) scale(1.05);
}

    @@media (max-width: 768px) {
        .card-container {
            width: 90%;
            padding: 2rem;
        }
        
        .create-circle {
            width: 120px;
            height: 120px;
        }
    }
</style>

    <nav class="navbar-horizontal">
        <a class="nav-link" asp-page="/Index">
            <i class="fas fa-home"></i>
            <span>Index</span>
        </a>
        <a class="nav-link" asp-page="/Dashboard">
            <i class="fas fa-chart-line"></i>
            <span>ISO Parameters</span>
        </a>
        <a class="nav-link" asp-page="/Trazability">
            <i class="fas fa-gas-pump"></i>
            <span>Trazability</span>
        </a>
        <a class="nav-link" asp-page="/New-Measurement/Index">
            <i class="fas fa-circle-plus"></i>
            <span>New Measurement</span>
        </a>
        <a class="nav-link" asp-page="/Certificates/CertificatesIndex">
            <i class="fas fa-certificate"></i>
            <span>Certificates</span>
        </a>
        
        <a class="nav-link" asp-page="/Movilabs/Index">
        <i class="fas fa-truck"></i>
        <span>Movilabs</span>
    </a>

        <a class="nav-link" asp-page="/Incidents">
            <i class="fas fa-exclamation-circle"></i>
            <span>Incidents</span>
        </a>
        <a class="nav-link" asp-page="/Privacy">
            <i class="fas fa-shield-alt"></i>
            <span>Privacy</span>
        </a>
    </nav>

    <div class="drag-drop-container">
        <div class="card-container">
            <div class="create-header">
                New H2 Fingerprint
            </div>
            <a asp-page="Create" class="create-circle">
                <i class="fa-solid fa-plus"></i>
            </a>
        </div>
    </div>
</body>
</html>
