@page
@model TrazabilityModel
@{
    ViewData["Title"] = "Trazability";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Contenedor del Mapa con estilo moderno -->
            <div class="map-container rounded-4 shadow-lg overflow-hidden border">
                <!-- Iframe del Mapa de Google -->
                <iframe src="https://www.google.com/maps/d/embed?mid=1CnMeU0ROazRUwOW5pbHMxkciSknnnq0&ehbc=21325a" 
                        class="w-100" 
                        style="height: 600px; border: 0;"
                        allowfullscreen 
                        loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</div>
=======
<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
    }

    #mapContainer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: calc(100vh - 80px); /* Resta la altura del navbar */
    }

    #mapWrapper {
        width: 100%;
        height: 100%;
    }

    #mapWrapper iframe {
        width: 100%;
        height: 100%;
        border: none;
        background: #f8f9fa;
    }

    #navbarHorizontal {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 80px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 25px;
        padding: 0 20px;
        z-index: 1000;
    }
</style>

<div id="mapContainer">
    <div id="mapWrapper">
        <iframe src="https://www.google.com/maps/d/embed?mid=1CnMeU0ROazRUwOW5pbHMxkciSknnnq0&ehbc=21325a"
                allowfullscreen 
                loading="lazy">
        </iframe>
    </div>
</div>

