@page
@model Loghid.Pages.CertificatesIndex 
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Lastest Certificates"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<style>
    body {
        background: linear-gradient(135deg, #0a192f 0%, #0d2342 100%);
        color: #ccd6f6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
        padding: 2rem 1rem 100px 1rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        backdrop-filter: blur(10px);
    }

    h2 {
        color: #64ffda;
        font-weight: 600;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #2f4368;
    }

    .row {
        gap: 1.5rem 0;
    }

    .card {
        background: rgba(23, 42, 69, 0.95);
        border: 1px solid #2f4368;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent 20%, #64ffda33 50%, transparent 80%);
        animation: gradientShift 20s infinite linear;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.4);
    }

    .card-header {
        background: rgba(31, 48, 79, 0.4);
        border-bottom: 1px solid #2f4368;
        padding: 1.5rem;
        position: relative;
        z-index: 1;
    }

    .card-title {
        color: #64ffda;
        margin: 0;
        font-size: 1.3rem;
        font-weight: 600;
    }

    .card-body {
        position: relative;
        z-index: 1;
        padding: 1.5rem;
    }

    .data-label {
        color: #88a9d6;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .card-text {
        color: #ccd6f6;
        font-size: 0.95rem;
        margin-bottom: 1rem;
    }

    .badge-custom {
        background: rgba(100, 255, 218, 0.1);
        color: #64ffda;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .edit-link {
        color: #64ffda;
        padding: 0.5rem;
        transition: all 0.3s ease;
    }

    .edit-link:hover {
        color: #88ffe5;
        transform: scale(1.1);
    }

    .download-link {
        background: #64ffda;
        color: #0a192f;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .download-link:hover {
        background: #88ffe5;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(100, 255, 218, 0.3);
    }

    .download-link i {
        color: #0a192f;
    }

    @@keyframes gradientShift {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Navbar sin cambios */
    .navbar-horizontal {
  width: 100%;
  height: 90px;
  position: fixed;
  bottom: 0;
  left: 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 25px;
  padding: 0 20px;
  z-index: 1030;
}

.nav-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px;
  border-radius: 16px;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 1.95);
  text-decoration: none !important;
  position: relative;
}

.nav-link i {
  font-size: 1.8rem;
  color: #2c3e50 !important;
  transition: all 0.3s ease;
}

.nav-link span {
  font-size: 0.75rem;
  color: #2c3e50;
  position: absolute;
  bottom: -25px;
  opacity: 0;
  transition: all 0.3s ease;
  white-space: nowrap;
}
.nav-link:hover {
  transform: translateY(-15px) scale(1.05);
  background: rgba(244, 244, 244, 0.7);
}

.nav-link:hover i {
  transform: scale(1.05);
}

.nav-link:hover span {
  opacity: 1;
  bottom: -20px;
}

.nav-link:hover + .nav-link,
.nav-link:hover ~ .nav-link {
  transform: translateY(-5px) scale(1.05);
}

    @@media (max-width: 768px) {
        .card {
            margin-bottom: 1rem;
        }
        
        .card-header {
            padding: 1rem;
        }
    }
</style>

<nav class="navbar-horizontal">
    <a class="nav-link" asp-page="/Index">
        <i class="fas fa-home"></i>
        <span>Index</span>
    </a>


    <a class="nav-link" asp-page="/Dashboard">
        <i class="fas fa-chart-line"></i>
        <span>ISO Parameters</span>
    </a>

    <a class="nav-link" asp-page="/Trazability">
        <i class="fas fa-gas-pump"></i>
        <span>Trazability</span>
    </a>

    <a class="nav-link" asp-page="/New-Measurement/Index">
        <i class="fas fa-circle-plus"></i>
        <span>New Measurement</span>
    </a>

    <a class="nav-link" asp-page="/Certificates/CertificatesIndex">
        <i class="fas fa-certificate"></i>
        <span>Certificates</span>
    </a>

    <a class="nav-link" asp-page="/Movilabs/Index">
        <i class="fas fa-truck"></i>
        <span>Movilabs</span>
    </a>

    <a class="nav-link" asp-page="/Incidents">
        <i class="fas fa-exclamation-circle"></i>
        <span>Incidents</span>
    </a>


    <a class="nav-link" asp-page="/Privacy">
        <i class="fas fa-shield-alt"></i>
        <span>Privacy</span>
    </a>

</nav>

<body>
    <div class="container">
        <h2>Loghid H2 Fingerprint Database</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in Model.ClientMeasurement)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title">Medición @item.PublicID_Measurement</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="data-label">Date</div>
                                    <div class="card-text">@item.Date_Measurement.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-12">
                                    <div class="data-label">Customer ID</div>
                                    <div class="card-text">@item.CustomerID_Measurement</div>
                                </div>
                                <div class="col-12 mt-3">
                                    <div class="data-label">Supplier ID</div>
                                    <span class="badge-custom">@item.SupplierID_Measurement</span>
                                </div>
                                <div class="col-12">
                                    <div class="data-label">Location</div>
                                    <div class="card-text">@item.Location_Measurement</div>
                                </div>
                                <div class="col-12">
                                    <div class="data-label">Notes</div>
                                    <div class="card-text">@item.Notes_Measurement</div>
                                </div>

                                <div class="col-12 mt-3 d-flex justify-content-between">
                                    <div class="edit2">
                                        <a asp-page="/New-Measurement/Details" asp-route-id="@item.Id_Measurement" class="edit-link">
                                            <i class="fas fa-circle-info"></i>
                                        </a>
                                        <a asp-page="/New-Measurement/Edit" asp-route-id="@item.Id_Measurement" class="edit-link">
                                            <i class="fas fa-pen-to-square"></i>
                                        </a>
                                        <a asp-page="/New-Measurement/Delete" asp-route-id="@item.Id_Measurement" class="edit-link">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                    <div class="download ml-auto">
                                        <a asp-page="/Certificates/CertificatesIndex" asp-page-handler="Download" asp-route-id="@item.Id_Measurement" class="download-link">
                                            <i class="fas fa-download"></i> Download
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="container-fluid">
        <p class="mb-0">.</p>
    </div>
    <div class="container-fluid">
        <p class="mb-0">.</p>
    </div>
</body>
</html>