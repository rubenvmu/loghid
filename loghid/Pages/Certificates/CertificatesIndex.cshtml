@page
@model Loghid.Pages.CertificatesIndex 

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Lastest Certificates"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .container {
            margin-top: 20px; /* Aumentar margen superior */
        }

        /* Estilo para las cards */
        .card {
            margin-bottom: 2rem;
            border: 0;
            border-radius: 0;
            background: #f8f9fa;
            transition: transform 0.3s;
            position: relative;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card-header {
            background: #2c3e50;
            color: white;
            border-radius: 0 !important;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-title {
            margin: 0;
            font-size: 1.25rem;
        }

        .download-btn {
            background: #2c3e50;
            border: none;
            padding: 0.5rem 1rem;
            color: white;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s;
        }

        .download-btn:hover {
            background: #2c3e50;
            transform: translateY(-2px);
        }

        .data-label {
            font-weight: 600;
            color: #455a64;
            font-size: 0.9rem;
        }

        .card-text {
            color: #37474f;
            font-size: 0.95rem;
        }

.navbar-horizontal {
  width: 100%;
  height: 90px;
  position: fixed;
  bottom: 0;
  left: 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 25px;
  padding: 0 20px;
  z-index: 1030;
}

.nav-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px;
  border-radius: 16px;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 1.95);
  text-decoration: none !important;
  position: relative;
}

.nav-link i {
  font-size: 1.8rem;
  color: #2c3e50 !important;
  transition: all 0.3s ease;
}

.nav-link span {
  font-size: 0.75rem;
  color: #2c3e50;
  position: absolute;
  bottom: -25px;
  opacity: 0;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.nav-link:hover {
  transform: translateY(-15px) scale(1.05);
  background: rgba(244, 244, 244, 0.7);
}

.nav-link:hover i {
  transform: scale(1.05);
}

.nav-link:hover span {
  opacity: 1;
  bottom: -20px;
}

/* Efecto para elementos adyacentes */
.nav-link:hover + .nav-link,
.nav-link:hover ~ .nav-link {
  transform: translateY(-5px) scale(1.05);
}


    </style>
</head>
<nav class="navbar-horizontal">
    <a class="nav-link" asp-page="/Index">
        <i class="fas fa-home"></i>
        <span>Index</span>
    </a>


    <a class="nav-link" asp-page="/Dashboard">
        <i class="fas fa-chart-line"></i>
        <span>ISO Parameters</span>
    </a>

    <a class="nav-link" asp-page="/Trazability">
        <i class="fas fa-gas-pump"></i>
        <span>Trazability</span>
    </a>

    <a class="nav-link" asp-page="/New-Measurement/Index">
        <i class="fas fa-circle-plus"></i>
        <span>New Measurement</span>
    </a>

    <a class="nav-link" asp-page="/Certificates/CertificatesIndex">
        <i class="fas fa-certificate"></i>
        <span>Certificates</span>
    </a>

    <a class="nav-link" asp-page="/News">
        <i class="fas fa-newspaper"></i>
        <span>News</span>
    </a>

    <a class="nav-link" asp-page="/Incidents">
        <i class="fas fa-exclamation-circle"></i>
        <span>Incidents</span>
    </a>

    <a class="nav-link" asp-page="/Support">
        <i class="fas fa-info-circle"></i>
        <span>Support</span>
    </a>

    <a class="nav-link" asp-page="/Privacy">
        <i class="fas fa-shield-alt"></i>
        <span>Privacy</span>
    </a>

</nav>
<body>
    <div class="container">
        <h2 class="mb-4">Lastest Certificates</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in Model.ClientMeasurement)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title">Medición @item.PublicID_Measurement</h5>
                            <button class="download-btn">
                                <i class="fas fa-download"></i>
                                <span>Download</span>
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="data-label">Date</div>
                                    <div class="card-text">@item.Date_Measurement.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-12">
                                    <div class="data-label">Customer</div>
                                    <div class="card-text">@item.Customer_Measurement</div>
                                </div>
                                <div class="col-12">
                                    <div class="data-label">Supplier</div>
                                    <div class="card-text">@item.Supplier_Measurement</div>
                                </div>
                                <div class="col-12">
                                    <div class="data-label">Location</div>
                                    <div class="card-text">@item.Location_Measurement</div>
                                </div>
                                <div class="col-12">
                                    <div class="data-label">Notes</div>
                                    <div class="card-text">@item.Notes_Measurement</div>
                                </div>
                                <div class="col-12 mt-3">
                                    <span class="badge-custom">Certificated by @item.SupplierID_Measurement</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>