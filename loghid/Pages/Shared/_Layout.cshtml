<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - loghid</title>
    
    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
</head>

@{
    ViewData["Title"] = "Loghid H2 Measurement & e-Traceability";
}

<body>
    <!-- Navbar Vertical Izquierda -->
    <nav class="navbar-vertical d-flex flex-column position-fixed top-0 left-0 h-100">
        <div class="navbar-vertical">
    <div class="flex-grow-1 d-flex flex-column pt-3">
        <div class="brand-icon">
            <i class="fas fa-leaf fa-2x text-white"></i>
        </div>

        <a class="nav-link" asp-controller="Home" asp-action="Index">
            <i class="fas fa-home fa-lg text-success"></i>
            <span class="d-none d-lg-inline">Home</span>
        </a>

        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
            <i class="fas fa-chart-line fa-lg text-success"></i>
            <span class="d-none d-lg-inline">Dashboard</span>
        </a>

        <a class="nav-link" asp-controller="Trazability" asp-action="Trazability">
            <i class="fas fa-map-marked-alt fa-lg text-success"></i>
            <span class="d-none d-lg-inline">Trazability</span>
        </a>
        
        <a class="nav-link" asp-controller="News" asp-action="Create">
            <i class="fas fa-newspaper fa-lg text-success"></i>
            <span class="d-none d-lg-inline">News</span>
        </a>

        <a class="nav-link" asp-controller="Incidents" asp-action="Create">
            <i class="fas fa-exclamation-circle fa-lg text-success"></i>
            <span class="d-none d-lg-inline">Incidents</span>
        </a>

        <a class="nav-link" asp-controller="Profile" asp-action="Create">
            <i class="fas fa-user-circle fa-lg text-success"></i>
            <span class="d-none d-lg-inline">Profile</span>
        </a>

        <a class="nav-link" asp-controller="Contact" asp-action="Create">
            <i class="fas fa-envelope fa-lg text-success"></i>
            <span class="d-none d-lg-inline">Contact</span>
        </a>

        <a class="nav-link" asp-controller="Privacy" asp-action="Privacy">
            <i class="fas fa-shield-alt fa-lg text-success"></i>
            <span class="d-none d-lg-inline">Privacy</span>
        </a>
    </div>
</div>
    </nav>

    <!-- Contenido Principal -->
    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer-custom mt-auto">
        <!-- ... (mantener mismo footer pero con btn-green en el botón de enviar) ... -->
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>