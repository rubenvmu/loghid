<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - loghid</title>
    
    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
</head>

@{
    ViewData["Title"] = "Loghid H2 Measurement & e-Traceability";
}

<body>
    <!-- Navbar Vertical Izquierda -->
    <nav class="navbar-vertical d-flex flex-column position-fixed top-0 left-0 h-100">
        <div class="brand-icon p-3">
            <i class="fas fa-database fa-lg text-white"></i>
        </div>
        
        <div class="flex-grow-1 d-flex flex-column">
            <a class="nav-link" asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i>
                <span class="d-none d-lg-inline">Inicio</span>
            </a>
            
            <a class="nav-link" asp-controller="AragonDorks" asp-action="Index">
                <i class="fas fa-map-marked-alt"></i>
                <span class="d-none d-lg-inline">Mapa</span>
            </a>
            
            <a class="nav-link" asp-controller="AragonDorks" asp-action="Create">
                <i class="fas fa-chart-line"></i>
                <span class="d-none d-lg-inline">Dashboard</span>
            </a>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer-custom mt-auto">
        <!-- ... (mantener mismo footer pero con btn-green en el botón de enviar) ... -->
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>