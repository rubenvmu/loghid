<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - loghid</title>
    
    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
</head>

@{
    ViewData["Title"] = "ISO ISO 14687-2 Loghid H2 Measurement & e-Traceability";
    
}

<body>
    <nav class="navbar-horizontal">
    <a class="nav-link" asp-page="/Index">
        <i class="fas fa-home"></i>
        <span>Index</span>
    </a>

    <a class="nav-link" asp-page="/Identify">
        <i class="fas fa-fingerprint"></i>
        <span>Identify</span>
    </a>

    <a class="nav-link" asp-page="/Dashboard">
        <i class="fas fa-chart-line"></i>
        <span>ISO-14687-2 Parameters</span>
    </a>

    <a class="nav-link" asp-page="/Trazability">
        <i class="fas fa-location-arrow"></i>
        <span>Trazability</span>
    </a>

    <a class="nav-link" asp-page="/New-Client-Measurement/Index">
        <i class="fas fa-circle-plus"></i>
        <span>New Client Measurement</span>
    </a>

    <a class="nav-link" asp-page="/Certificates">
        <i class="fas fa-certificate"></i>
        <span>Certificates</span>
    </a>

    <a class="nav-link" asp-page="/News">
        <i class="fas fa-newspaper"></i>
        <span>News</span>
    </a>

    <a class="nav-link" asp-page="/Incidents">
        <i class="fas fa-exclamation-circle"></i>
        <span>Incidents</span>
    </a>

    <a class="nav-link" asp-page="/Support">
        <i class="fas fa-info-circle"></i>
        <span>Support</span>
    </a>

    <a class="nav-link" asp-page="/Privacy">
        <i class="fas fa-shield-alt"></i>
        <span>Privacy</span>
    </a>

</nav>


    <!-- Contenido Principal -->
    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer-custom mt-auto">
        <!-- ... (mantener mismo footer pero con btn-green en el botón de enviar) ... -->
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>