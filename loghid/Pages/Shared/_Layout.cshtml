using _Layout.cshtml.css;

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - loghid</title>
    
    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        :root {
            --primary-green: white;
            --accent-green: #c8e6c9;
            --dark-green: #81c784;
        }
        .navbar-vertical {
          width: 80px;
          height: 100vh;
          position: fixed;
          left: 0;  /* Cambiado a left: 0 para pegarlo a la izquierda */
          top: 0;
          background: linear-gradient(180deg, #ffffff 0%, var(--primary-green) 100%);
          box-shadow: 2px 0 8px rgba(0,0,0,0.05);
          transition: width 0.3s ease;
          z-index: 1030;
      }
      
      /* Expansión del Navbar al pasar el mouse */
      .navbar-vertical:hover {
          width: 200px;
      }
      
      /* Estilo de los Enlaces del Navbar */
      .nav-link {
          white-space: nowrap;
          overflow: hidden;
          color: #6c757d !important;
          padding: 0.75rem 1.5rem;
          border-radius: 8px;
          margin: 0.5rem;
          transition: all 0.2s ease;
      }
      
      /* Efecto Hover en los Enlaces */
      .nav-link:hover {
          background: var(--accent-green);
          transform: translateX(5px);
      }
      
      .nav-link i {
          margin-right: 1rem;
          min-width: 25px;
      }
      
      .main-content {
          margin-left: 100px; /* Ajustado el margen para que no se superponga al navbar */
          transition: margin 0.3s ease;
      }
      
      /* Estilo del Pie de Página */
      .footer-custom {
          background: linear-gradient(90deg, var(--primary-green) 0%, #ffffff 100%);
          color: #6c757d;
          border-top: 1px solid #dee2e6;
      }
      
      /* Icono de la Marca */
      .brand-icon {
          background: var(--dark-green);
          width: 50px;
          height: 50px;
          border-radius: 12px;
          display: flex;
          align-items: center;
          justify-content: center;
          margin: 1rem auto;
      }
      
      /* Estilo de Botones */
      .btn-green {
          background: linear-gradient(135deg, var(--dark-green) 0%, #4caf50 100%);
          color: white !important;
          border: none;
          padding: 8px 20px;
          border-radius: 25px;
      }
    </style>
</head>
<body>
    <!-- Navbar Vertical Izquierda -->
    <nav class="navbar-vertical d-flex flex-column position-fixed top-0 left-0 h-100">
        <div class="brand-icon p-3">
            <i class="fas fa-database fa-lg text-white"></i>
        </div>
        
        <div class="flex-grow-1 d-flex flex-column">
            <a class="nav-link" asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i>
                <span class="d-none d-lg-inline">Inicio</span>
            </a>
            
            <a class="nav-link" asp-controller="AragonDorks" asp-action="Index">
                <i class="fas fa-map-marked-alt"></i>
                <span class="d-none d-lg-inline">Mapa</span>
            </a>
            
            <a class="nav-link" asp-controller="AragonDorks" asp-action="Create">
                <i class="fas fa-chart-line"></i>
                <span class="d-none d-lg-inline">Dashboard</span>
            </a>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer-custom mt-auto">
        <!-- ... (mantener mismo footer pero con btn-green en el botón de enviar) ... -->
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>