@page
@using Loghid.Pages
@using System.Linq
@model Loghid.Pages.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <h1 class="text-center mb-5">@ViewData["Title"]</h1>

    @foreach (var substance in new List<dynamic>
    {
        new { Name = "Water", Data = Model.WaterData },
        new { Name = "Methane", Data = Model.MethaneData },
        new { Name = "Non-CH4 Hydrocarbons", Data = Model.NonCH4HydrocarbonsData },
        new { Name = "Oxygen", Data = Model.OxygenData },
        new { Name = "Helium", Data = Model.HeliumData },
        new { Name = "Nitrogen", Data = Model.NitrogenData },
        new { Name = "Argon", Data = Model.ArgonData },
        new { Name = "Carbon Dioxide", Data = Model.CarbonDioxideData },
        new { Name = "Carbon Monoxide", Data = Model.CarbonMonoxideData },
        new { Name = "Sulphur Compounds", Data = Model.SulphurCompoundsData },
        new { Name = "Formaldehyde", Data = Model.FormaldehydeData },
        new { Name = "Formic Acid", Data = Model.FormicAcidData },
        new { Name = "Ammonia", Data = Model.AmmoniaData },
        new { Name = "Halogenated Compounds", Data = Model.HalogenatedCompoundsData },
        new { Name = "Hydrocarbons", Data = Model.HydrocarbonsData }
    })
    {
        <div class="substance-table mb-5 p-4 bg-light rounded shadow-sm">
            <h2 class="mb-4 text-primary">@substance.Name</h2>

            @if (substance.Data != null && substance.Data.Any())
            {
                <table class="table table-striped table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>ISO Threshold</th>
                            <th>PEM Min</th>
                            <th>PEM Max</th>
                            <th>Probability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in substance.Data)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.IsoThreshold?.ToString("N2") ?? "N/A"</td>
                                <td>@item.PemResultMin?.ToString("N2") ?? "N/A"</td>
                                <td>@item.PemResultMax?.ToString("N2") ?? "N/A"</td>
                                <td>@item.Probability?.ToString("P1") ?? "N/A"</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning">No data available for @substance.Name</div>
            }
        </div>
    }
</div>