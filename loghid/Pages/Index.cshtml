

@page
@model Loghid.Pages.IndexModel

@{
    ViewData["Title"] = "Loghid H2 Measurement & e-Traceability";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loghid</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-image: url('/images/b3.png'); /* URL de la imagen de fondo */
            background-size: cover;
            background-position: center;
            height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: flex-end; /* Alinea el contenido a la derecha */
            align-items: center;
        }

        .auth-container {
        background: rgba(23, 42, 69, 0.98);
        width: 100%;
        max-width: 440px;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border: 1px solid #2f4368;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .auth-container::before {
        content: '';
        position: absolute;
        top: -150%;
        left: -50%;
        width: 200%;
        height: 400%;
        background: linear-gradient(
            45deg,
            transparent 25%,
            rgba(100, 255, 218, 0.15) 50%,
            transparent 75%
        );
        animation: laserSweep 12s infinite linear;
        filter: blur(15px);
    }

    @@keyframes laserSweep {
        0% { transform: rotate(45deg) translateY(-150%); }
        100% { transform: rotate(45deg) translateY(150%); }
    }

    /* Asegurar que el contenido esté por encima del efecto */
    .auth-header, form, .lorem-text {
        position: relative;
        z-index: 2;
    }

        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-header h2 {
            color: #64ffda; /* Texto en azul oscuro */
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .auth-header i {
            font-size: 2.5rem;
            color: #64ffda; /* Icono en azul oscuro */
            margin-bottom: 1rem;
            padding: 1rem;
            border-radius: 50%;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-control {
            width: 100%;
            padding: 0.875rem 1.5rem;
            border: 2px solid #e9ecef;
            font-size: 1rem;
        }

        .btn-primary {
            background: #64ffda; /* Botón en azul oscuro */
            color: #1a2a3a;
            padding: 1rem 2rem;
            border: none;
            border-radius: 0.75rem;
            width: 100%;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
        }

        .auth-footer {
            text-align: center;
            margin-top: 1.5rem;
            color: #88a9d6;
        }

        .auth-footer a {
            color: var(--dark-blue); /* Enlace en azul oscuro */
            text-decoration: none;
            font-weight: 500;
        }

        .lorem-text {
            text-align: center;
            margin-top: 2rem;
            font-size: 0.9rem;
            color: #88a9d6;
        }
    </style>
</head>
<body>
    <div class="container-dashboard">

    <div id="authMainContainer" class="auth-container">
        <img src="/images/loghid_logo_es.png" alt="loghid_logo_es" style="width: 100%; height: auto;" />
        <form action="#">
            <div class="form-group">
                <input type="text" class="form-control" placeholder="loghid@loghid.com" required />
            </div>
            <div class="form-group">
                <input type="password" class="form-control" placeholder="*************" required />
            </div>
            <div class="form-group">
                <button type="submit" class="btn-primary">Access</button>
            </div>
        </form>

        <div class="lorem-text">
            <p>Loghid is the largest green hydrogen measurement and traceability platform in Spain. Contact our team. Legal</p>
            <br>
            <h5>Powered by</h5>
            <img src="/images/partners.png" alt="Partners" style="width: 100%; height: auto;" />
            
        </div>
    </div>
</body>
</html>