@page
@model Loghid.Pages.IndexModel

@{
    ViewData["Title"] = "Loghid H2 Measurement & e-Traceability";
}

<h1>@ViewData["Title"]</h1>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Contenedor del Mapa con estilo moderno -->
            <div class="map-container rounded-4 shadow-lg overflow-hidden border">
                <!-- Iframe del Mapa de Google -->
                <iframe src="https://www.google.com/maps/d/embed?mid=1CnMeU0ROazRUwOW5pbHMxkciSknnnq0&ehbc=21325a" 
                        class="w-100" 
                        style="height: 600px; border: 0;"
                        allowfullscreen 
                        loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid p-3">
    <h4 class="mb-4">Chemical Substances Dashboard</h4>
    
    <div class="row g-3">
        @foreach (var substance in Model.Substances)
        {
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">@substance.SubstanceName</h6>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@substance.Id" class="btn btn-sm btn-link p-0">✏️</a>
                            <a asp-page="./Details" asp-route-id="@substance.Id" class="btn btn-sm btn-link p-0">🔍</a>
                        </div>
                    </div>
                    <div class="card-body p-2">
                        <table class="table table-sm table-borderless mb-0 card-table">
                            <tbody>
                            <tr>
                                <th width="45%">ISO Threshold</th>
                                <td>@substance.IsoThreshold</td>
                            </tr>
                            <tr>
                                <th>Measurement</th>
                                <td>@substance.MeasurementMethod</td>
                            </tr>
                            <tr>
                                <th>Range</th>
                                <td>@substance.MeasuredRange</td>
                            </tr>
                            <tr>
                                <th>Probability</th>
                                <td>@substance.Probability</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>