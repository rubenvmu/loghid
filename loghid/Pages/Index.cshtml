@page
@using Loghid.Pages
@using System.Linq
@model Loghid.Pages.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <h1 class="text-center mb-5">@ViewData["Title"]</h1>

    @foreach (var substance in Model.Substances)
    {
        <div class="substance-table mb-5 p-4 bg-light rounded shadow-sm">
            <h2 class="mb-4 text-primary">@substance.Name</h2>

            @if (substance.Data != null && substance.Data.Any())
            {
                <table class="table table-striped table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>ISO Threshold</th>
                            <th>Probability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in substance.Data)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.IsoThreshold.ToString("N2")</td>
                                <td>@item.Probability</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning">No data available for @substance.Name</div>
            }
        </div>
    }
</div>