
@page
@model Loghid.Pages.IndexModel

@{
    ViewData["Title"] = "Loghid H2 Measurement & e-Traceability";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loghid</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #ffffff;
            --accent-green: #ffffff;
            --dark-blue: #1a2a3a; /* Color azul oscuro */
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-image: url('/images/loghid_main_panel.png'); /* URL de la imagen de fondo */
            background-size: cover;
            background-position: center;
            height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: flex-end; /* Alinea el contenido a la derecha */
            align-items: center;
        }

        .auth-container {
            background: white;
            width: 100%; /* Ocupa un tercio del ancho de la pantalla */
            max-width: 440px;
            padding: 2.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: none;
            height: 100vh; /* Ocupa toda la altura de la pantalla */
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-header h1 {
            color: var(--dark-blue); /* Texto en azul oscuro */
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .auth-header i {
            font-size: 2.5rem;
            color: var(--dark-blue); /* Icono en azul oscuro */
            margin-bottom: 1rem;
            padding: 1rem;
            border-radius: 50%;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-control {
            width: 100%;
            padding: 0.875rem 1.5rem;
            border: 2px solid #e9ecef;
            font-size: 1rem;
        }

        .btn-primary {
            background: var(--dark-blue); /* Botón en azul oscuro */
            color: white;
            padding: 1rem 2rem;
            border: none;
            border-radius: 0.75rem;
            width: 100%;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
        }

        .auth-footer {
            text-align: center;
            margin-top: 1.5rem;
            color: #6c757d;
        }

        .auth-footer a {
            color: var(--dark-blue); /* Enlace en azul oscuro */
            text-decoration: none;
            font-weight: 500;
        }

        .lorem-text {
            text-align: center;
            margin-top: 2rem;
            font-size: 0.9rem;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div id="authMainContainer" class="auth-container">
        <div class="auth-header">
            <i class="fas fa-gas-pump"></i>
            <h1>Loghid H2 Measurement & e-Traceability</h1>
        </div>

        <form action="#">
            <div class="form-group">
                <input type="text" class="form-control" placeholder="Usuario" required />
            </div>
            <div class="form-group">
                <input type="password" class="form-control" placeholder="Contraseña" required />
            </div>
            <div class="form-group">
                <button type="submit" class="btn-primary">Acceder</button>
            </div>
        </form>

        <div class="lorem-text">
            <p>Loghid es la mayor plataforma de medición y trazabilidad de hidrógeno verde de España. Contacta con nuestro equipo. Legal.</p>
        </div>
    </div>
</body>
</html>