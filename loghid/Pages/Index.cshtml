@page
@model Loghid.Pages.IndexModel

@{
    ViewData["Title"] = "Loghid H2 Measurement & e-Traceability";
}

<h1>@ViewData["Title"]</h1>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Contenedor del Mapa con estilo moderno -->
            <div class="map-container rounded-4 shadow-lg overflow-hidden border">
                <!-- Iframe del Mapa de Google -->
                <iframe src="https://www.google.com/maps/d/embed?mid=1CnMeU0ROazRUwOW5pbHMxkciSknnnq0&ehbc=21325a" 
                        class="w-100" 
                        style="height: 600px; border: 0;"
                        allowfullscreen 
                        loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</div>

@if (Model?.CombinedSubstances == null || !Model.CombinedSubstances.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        No sustances availables.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.CombinedSubstances)
        {
            var entityType = item.GetType().Name;
            
            <div class="col">
                <div class="card h-100 border-2 border-success shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-flask me-2"></i>
                            @Html.DisplayFor(modelItem => item.SubstanceName)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-12 d-flex align-items-center">
                                <i class="fas fa-ruler-combined text-success me-2"></i>
                                <span class="fw-bold">ISO Threshold:</span>
                                <span class="ms-2">@Html.DisplayFor(modelItem => item.IsoThreshold)</span>
                            </div>
                        </div>
                        
                        <div class="row mb-2">
                            <div class="col-12 d-flex align-items-center">
                                <i class="fas fa-vial text-success me-2"></i>
                                <span class="fw-bold">Method:</span>
                                <span class="ms-2">@Html.DisplayFor(modelItem => item.MeasurementMethod)</span>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12 d-flex align-items-center">
                                <i class="fas fa-chart-area text-success me-2"></i>
                                <span class="fw-bold">Range:</span>
                                <span class="ms-2">@Html.DisplayFor(modelItem => item.MeasuredRange)</span>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12 d-flex align-items-center">
                                <i class="fas fa-percent text-success me-2"></i>
                                <span class="fw-bold">Probability:</span>
                                <span class="ms-2">@Html.DisplayFor(modelItem => item.Probability)</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <div class="d-flex justify-content-between">
                            <a class="btn btn-sm btn-outline-success" asp-page="/@entityType/Edit" asp-route-id="@item.Id">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <a class="btn btn-sm btn-outline-success" asp-page="/@entityType/Details" asp-route-id="@item.Id">
                                <i class="fas fa-eye me-1"></i>Details
                            </a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="/@entityType/Delete" asp-route-id="@item.Id">
                                <i class="fas fa-trash me-1"></i>Remove
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .card {
        border-radius: 15px;
        transition: transform 0.3s, box-shadow 0.3s;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(40, 167, 69, 0.15);
    }
    
    .card-header {
        border-radius: 13px 13px 0 0 !important;
    }
</style>
    
</div>