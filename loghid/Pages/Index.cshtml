@page
@model Loghid.Pages.IndexModel

@{
    ViewData["Title"] = "Loghid H2 Measurement & e-Traceability";
}

<h1>@ViewData["Title"]</h1>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Contenedor del Mapa con estilo moderno -->
            <div class="map-container rounded-4 shadow-lg overflow-hidden border">
                <!-- Iframe del Mapa de Google -->
                <iframe src="https://www.google.com/maps/d/embed?mid=1CnMeU0ROazRUwOW5pbHMxkciSknnnq0&ehbc=21325a" 
                        class="w-100" 
                        style="height: 600px; border: 0;"
                        allowfullscreen 
                        loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</div>

@if (Model?.CombinedSubstances == null || !Model.CombinedSubstances.Any())
{
    <p>No hay sustancias disponibles.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.CombinedSubstances[0].SubstanceName)</th>
                <th>@Html.DisplayNameFor(model => model.CombinedSubstances[0].IsoThreshold)</th>
                <th>@Html.DisplayNameFor(model => model.CombinedSubstances[0].MeasurementMethod)</th>
                <th>@Html.DisplayNameFor(model => model.CombinedSubstances[0].MeasuredRange)</th>
                <th>@Html.DisplayNameFor(model => model.CombinedSubstances[0].Probability)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CombinedSubstances)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.SubstanceName)</td>
                    <td>@Html.DisplayFor(modelItem => item.IsoThreshold)</td>
                    <td>@Html.DisplayFor(modelItem => item.MeasurementMethod)</td>
                    <td>@Html.DisplayFor(modelItem => item.MeasuredRange)</td>
                    <td>@Html.DisplayFor(modelItem => item.Probability)</td>
                    <td>
                        @{
                            var entityType = item.GetType().Name;
                        }
                        <a asp-page="/@entityType/Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-page="/@entityType/Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-page="/@entityType/Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
    
</div>