@page
@model Loghid.Pages.IndexModel


<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Contenedor del Mapa con estilo moderno -->
            <div class="map-container rounded-4 shadow-lg overflow-hidden border">
                <!-- Iframe del Mapa de Google -->
                <iframe src="https://www.google.com/maps/d/embed?mid=1CnMeU0ROazRUwOW5pbHMxkciSknnnq0&ehbc=21325a" 
                        class="w-100" 
                        style="height: 600px; border: 0;"
                        allowfullscreen 
                        loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <h1 class="text-center mb-5">@ViewData["Title"]</h1>

    <div class="row">
        @foreach (var substance in Model.Substances)
        {
            <div class="col-md-4 mb-4">
                <div class="substance-card p-4 bg-light rounded shadow-sm">
                    <h2 class="mb-4 text-primary">
                        <i class="fas fa-flask mr-2"></i>
                        @substance.GetType().Name
                    </h2>

                    @if (substance != null)
                    {
                        <table class="table table-striped table-hover table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>ISO Threshold</th>
                                    <th>Probability</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@substance.Id</td>
                                    <td>@substance.IsoThreshold.ToString("N2")</td>
                                    <td>@substance.Probability</td>
                                </tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-warning">No data available for this substance</div>
                    }
                </div>
            </div>
        }
    </div>
</div>