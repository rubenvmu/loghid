@page
@model loghid.Pages.New_Client_Measurement.EditModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit</title>
</head>
<body>
<style>
    :root {
        --primary-blue: #2c3e50;
        --secondary-blue: #f5f6fa;
        --accent-blue: #3498db;
        --border-color: #e2e8f0;
        --shadow-light: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        --shadow-medium: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        --text-color: #2d3748;
        --error-color: #e53e3e;
    }

    body {
        background-color: #ffffff;
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.6;
        color: var(--text-color);
        margin: 0;
        padding: 0;
    }

    .col-md-4 {
        max-width: 100%;
        padding: 2rem;
        background: white;
        box-shadow: var(--shadow-light);
        border: 1px solid var(--border-color);
        margin: 2rem auto;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        font-weight: 500;
        margin-bottom: 0.5rem;
        color: var(--primary-blue);
    }

    .form-group label span.text-danger {
        color: var(--error-color);
        margin-right: 0.25rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--border-color);
        background: white;
        font-size: 0.925rem;
        color: var(--text-color);
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        border-color: var(--accent-blue);
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
        outline: none;
    }

    .text-danger {
        color: var(--error-color);
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }

    .btn-primary {
        background: var(--accent-blue);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s, box-shadow 0.2s;
        box-shadow: var(--shadow-light);
    }

    .btn-primary:hover {
        background: #2980b9;
        box-shadow: var(--shadow-medium);
    }

    a {
        color: var(--accent-blue);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

    a:hover {
        color: #2980b9;
    }

    @@media (max-width: 768px) {
        .col-md-4 {
            padding: 1rem;
            margin: 1rem;
        }

        .form-control {
            padding: 0.5rem;
        }

        .btn-primary {
            width: 100%;
            padding: 0.75rem;
        }
    }
</style>

