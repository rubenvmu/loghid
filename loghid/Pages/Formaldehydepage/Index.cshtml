@page
@model loghid.Pages.Formaldehydepage.IndexModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Formaldehyde[0].SubstanceName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Formaldehyde[0].IsoThreshold)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Formaldehyde[0].MeasurementMethod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Formaldehyde[0].MeasuredRange)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Formaldehyde[0].Probability)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Formaldehyde) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SubstanceName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsoThreshold)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MeasurementMethod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MeasuredRange)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Probability)
            </td>
        </tr>
}
    </tbody>
</table>
</body>
</html>
